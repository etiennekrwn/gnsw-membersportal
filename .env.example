# Copy this file to .env.local for local development
# Set these in the Railway dashboard for production

# Backend API URL (local dev default)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Paystack public key used to render the in-page payment modal (Paystack Inline).
# Set the matching secret key in the backend (PAYSTACK_SECRET_KEY).
VITE_PAYSTACK_PUBLIC_KEY=pk_test_16f126398d85f59ccfca38bf27ce7dcffcbcd15d

# URL of the main public GNSW website (used for the "Become a Member" CTA)
VITE_MAIN_SITE_URL=http://localhost:5173
